{
  "name": "saihub-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE",
        "class_name": "Device"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Device"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saihub",
      "database_id": "1e9eb771-42c5-48bc-9d91-aae1c4ad7e09",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_TIMEOUT_MS": "10000",
    "REQUEST_TIMEOUT_MS": "55000"
  }
}
