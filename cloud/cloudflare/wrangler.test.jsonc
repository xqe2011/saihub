{
  "name": "saihub-cloud-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE",
        "class_name": "Device"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Device"]
    }
  ],
  "vars": {
    "AUTH_TIMEOUT_MS": "2000",
    "REQUEST_TIMEOUT_MS": "2000",
    "ROUTING_TOKEN_SECRET": "local-dev-routing-token-secret"
  }
}
