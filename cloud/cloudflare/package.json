{
  "name": "saihub-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrations:apply:local && wrangler dev",
    "deploy": "npm run db:migrations:apply && wrangler deploy",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "bun test ../../tests/cloud/cloudflare/*.test.ts",
    "test:hardware": "bun ../../tests/hardware/smoke.ts",
    "fake-device": "bun ../../tests/cloud/cloudflare/fake-device.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.37.0"
  }
}
