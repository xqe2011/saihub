        ],
        "summary": "Run a Lua script on-device",
        "description": "Execute a sandboxed Lua script that can call the same tools as MCP (pin/power/lock). Optional maxCalls and timeout (microseconds) must not exceed firmware ceilings. Default lock for nested tool calls: X-Lock-Id. One script at a time.",
        "parameters": [
          {
            "name": "X-Lock-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Default lockId injected into tool calls that omit lockId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "script"
                ],
                "additionalProperties": false,
                "properties": {
                  "script": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192,
                    "description": "Lua source"
                  },
                  "maxCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256,
                    "description": "Max tool invocations this run (default and ceiling from firmware)"
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000,
                    "description": "Wall-clock budget in microseconds (default and ceiling from firmware)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Script finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScriptResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "408": {
            "$ref": "#/components/responses/RequestTimeout"
          },
          "409": {
            "$ref": "#/components/responses/ScriptBusy"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/lock": {
      "post": {
        "tags": [
          "lock"
        ],
        "summary": "Create a lock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resources"
                ],
                "properties": {
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/components/schemas/LockResource"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lock"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/lock/{id}": {
      "put": {
        "tags": [
          "lock"
        ],
        "summary": "Renew a lock",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Renewed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "ttl",
                    "expiresAt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "ttl": {
                      "$ref": "#/components/schemas/TimeUs"
                    },
                    "expiresAt": {
                      "$ref": "#/components/schemas/TimeUs"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "lock"
        ],
        "summary": "Delete a lock (idempotent)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted or already gone"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PinPath": {
        "name": "pin",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "XLockId": {
        "name": "X-Lock-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Required when another lock holds the resource+method (pin or power rail). Missing or unknown yields 412; a different live holder yields 423."
      }
    },
    "schemas": {
      "TimeUs": {
        "type": "integer",
        "format": "int64",
        "description": "Unix epoch or duration in microseconds"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "disable",
          "digitalInput",
          "digitalOutput",
          "digitalInputOutput",
          "pwmOutput"
        ]
      },
      "Edge": {
        "type": "string",
        "enum": [
          "raising",
          "falling",
          "both"
        ]
      },
      "Pins": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "PinConfig": {
        "type": "object",
        "required": [
          "mode",
          "pullUp",
          "pullDown"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "openDrain": {
            "type": "boolean",
            "default": false,
            "description": "Allowed for digitalOutput, digitalInputOutput, and pwmOutput"
          },
          "pullUp": {
            "type": "boolean"
          },
          "pullDown": {
            "type": "boolean"
          }
        }
      },
      "PinState": {
        "type": "object",
        "required": [
          "pin",
          "mode",
          "openDrain",
          "pullUp",
          "pullDown",
          "level"
        ],
        "properties": {
          "pin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "openDrain": {
            "type": "boolean"
          },
          "pullUp": {
            "type": "boolean"
          },
          "pullDown": {
            "type": "boolean"
          },
          "level": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "digitalOutput: last written latch. Otherwise sampled pad input."
          }
        }
      },
      "PwmBody": {
        "type": "object",
        "required": [
          "frequency",
          "duty"
        ],
        "properties": {
          "frequency": {
            "type": "number",
            "minimum": 1,
            "maximum": 50000,
            "description": "Hz. Very low frequencies may be rejected."
          },
          "duty": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Percent, decimals allowed"
          }
        }
      },
      "PwmState": {
        "type": "object",
        "required": [
          "frequency",
          "duty",
          "time"
        ],
        "properties": {
          "frequency": {
            "type": "number",
            "minimum": 1,
            "maximum": 50000
          },
          "duty": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "time": {
            "$ref": "#/components/schemas/TimeUs"
          }
        }
      },
      "PulseBody": {
        "type": "object",
        "required": [
          "width",
          "level"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Microseconds"
          },
          "level": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "TraceEvent": {
        "type": "object",
        "required": [
          "edge",
          "level",
          "time"
        ],
        "properties": {
          "edge": {
            "type": "string",
            "enum": [
              "raising",
              "falling"
            ]
          },
          "level": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "time": {
            "$ref": "#/components/schemas/TimeUs"
          }
        }
      },
      "TraceEventWithPin": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TraceEvent"
          },
          {
            "type": "object",
            "required": [
              "pin"
            ],
            "properties": {
              "pin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            }
          }
        ]
      },
      "LockMethod": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "PowerEnable": {
        "type": "object",
        "required": [
          "enable"
        ],
        "properties": {
          "enable": {
            "type": "boolean"
          }
        }
      },
      "PowerState": {
        "type": "object",
        "required": [
          "enable",
          "time"
        ],
        "properties": {
          "enable": {
            "type": "boolean"
          },
          "time": {
            "$ref": "#/components/schemas/TimeUs"
          }
        }
      },
      "LockResource": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "pins",
              "method"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "pin"
              },
              "pins": {
                "$ref": "#/components/schemas/Pins"
              },
              "method": {
                "$ref": "#/components/schemas/LockMethod"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "rails",
              "method"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "power"
              },
              "rails": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "3v3",
                    "5v"
                  ]
                }
              },
              "method": {
                "$ref": "#/components/schemas/LockMethod"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "Lock": {
        "type": "object",
        "required": [
          "id",
          "ttl",
          "expiresAt",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ttl": {
            "$ref": "#/components/schemas/TimeUs"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/TimeUs"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LockResource"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Human-readable fix sentence, except invalid_json and internal"
          }
        }
      },
      "ScriptResult": {
        "type": "object",
        "required": [
          "result",
          "output",
          "calls",
          "elapsed"
        ],
        "properties": {
          "result": {
            "description": "First Lua return value as JSON, or null",
            "nullable": true
          },
          "output": {
            "type": "string",
            "description": "Captured print() output"
          },
          "calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Tool invocations performed"
          },
          "elapsed": {
            "$ref": "#/components/schemas/TimeUs"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "invalid_json or out-of-range body/query params",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown URL, pin in path out of 0-7, or lock id missing on PUT",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "POST /lock overlaps an existing lock",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RequestTimeout": {
        "description": "Script exceeded timeout",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ScriptBusy": {
        "description": "Another script is already running",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PreconditionFailed": {
        "description": "X-Lock-Id missing or unknown/expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type must be application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Pin mode cannot perform the operation, or PWM resources exhausted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Locked": {
        "description": "Resource+method held by a different live lock",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
