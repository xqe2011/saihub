{
  "openapi": "3.1.0",
  "info": {
    "title": "Saihub GPIO REST API",
    "version": "1.0.0",
    "description": "No-TLS JSON REST API for logical GPIO pins 0-7, edge tracing, and resource locks. All time fields are microseconds. JSON keys are camelCase."
  },
  "servers": [
    {
      "url": "http://{host}",
      "variables": {
        "host": {
          "default": "192.168.1.100"
        }
      }
    }
  ],
  "tags": [
    { "name": "gpios" },
    { "name": "locks" },
    { "name": "meta" }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": ["meta"],
        "summary": "OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/gpios/": {
      "get": {
        "tags": ["gpios"],
        "summary": "List all logical pins 0-7",
        "parameters": [
          { "$ref": "#/components/parameters/XLockId" }
        ],
        "responses": {
          "200": {
            "description": "GPIO inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["gpios", "time"],
                  "properties": {
                    "gpios": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/GpioState" }
                    },
                    "time": { "$ref": "#/components/schemas/TimeUs" }
                  }
                }
              }
            }
          },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/{pin}/config": {
      "put": {
        "tags": ["gpios"],
        "summary": "Configure a pin (no interrupt)",
        "parameters": [
          { "$ref": "#/components/parameters/PinPath" },
          { "$ref": "#/components/parameters/XLockId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GpioConfig" }
            }
          }
        },
        "responses": {
          "204": { "description": "Configured" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/{pin}/level": {
      "get": {
        "tags": ["gpios"],
        "summary": "Read pin level",
        "parameters": [
          { "$ref": "#/components/parameters/PinPath" },
          { "$ref": "#/components/parameters/XLockId" }
        ],
        "responses": {
          "200": {
            "description": "Level sample",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["level", "time"],
                  "properties": {
                    "level": { "type": "integer", "enum": [0, 1] },
                    "time": { "$ref": "#/components/schemas/TimeUs" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      },
      "post": {
        "tags": ["gpios"],
        "summary": "Write pin level",
        "parameters": [
          { "$ref": "#/components/parameters/PinPath" },
          { "$ref": "#/components/parameters/XLockId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["level"],
                "properties": {
                  "level": { "type": "integer", "enum": [0, 1] }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Written" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/{pin}/pulse": {
      "post": {
        "tags": ["gpios"],
        "summary": "Pulse pin for width microseconds then invert",
        "parameters": [
          { "$ref": "#/components/parameters/PinPath" },
          { "$ref": "#/components/parameters/XLockId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PulseBody" }
            }
          }
        },
        "responses": {
          "204": { "description": "Pulsed" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/{pin}/trace": {
      "get": {
        "tags": ["gpios"],
        "summary": "Capture edge events on one pin",
        "parameters": [
          { "$ref": "#/components/parameters/PinPath" },
          { "$ref": "#/components/parameters/XLockId" },
          {
            "name": "edge",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/Edge" }
          },
          {
            "name": "duration",
            "in": "query",
            "description": "Capture window in microseconds (max 60000000)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 60000000 }
          }
        ],
        "responses": {
          "200": {
            "description": "Events only",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["events"],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TraceEvent" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/level": {
      "get": {
        "tags": ["gpios"],
        "summary": "Batch read levels",
        "parameters": [{ "$ref": "#/components/parameters/XLockId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pins"],
                "properties": {
                  "pins": { "$ref": "#/components/schemas/Pins" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Levels in pins order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["levels", "time"],
                  "properties": {
                    "levels": {
                      "type": "array",
                      "items": { "type": "integer", "enum": [0, 1] }
                    },
                    "time": { "$ref": "#/components/schemas/TimeUs" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      },
      "post": {
        "tags": ["gpios"],
        "summary": "Batch write level",
        "parameters": [{ "$ref": "#/components/parameters/XLockId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pins", "level"],
                "properties": {
                  "pins": { "$ref": "#/components/schemas/Pins" },
                  "level": { "type": "integer", "enum": [0, 1] }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Written" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/config": {
      "put": {
        "tags": ["gpios"],
        "summary": "Batch configure pins",
        "parameters": [{ "$ref": "#/components/parameters/XLockId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/GpioConfig" },
                  {
                    "type": "object",
                    "required": ["pins"],
                    "properties": {
                      "pins": { "$ref": "#/components/schemas/Pins" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Configured" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/pulse": {
      "post": {
        "tags": ["gpios"],
        "summary": "Batch pulse",
        "parameters": [{ "$ref": "#/components/parameters/XLockId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/PulseBody" },
                  {
                    "type": "object",
                    "required": ["pins"],
                    "properties": {
                      "pins": { "$ref": "#/components/schemas/Pins" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Pulsed" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/gpios/trace": {
      "get": {
        "tags": ["gpios"],
        "summary": "Batch edge capture",
        "parameters": [{ "$ref": "#/components/parameters/XLockId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pins"],
                "properties": {
                  "pins": { "$ref": "#/components/schemas/Pins" },
                  "edge": { "$ref": "#/components/schemas/Edge" },
                  "duration": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60000000,
                    "description": "Microseconds"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Events with pin",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["events"],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TraceEventWithPin" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "423": { "$ref": "#/components/responses/Locked" }
        }
      }
    },
    "/locks": {
      "post": {
        "tags": ["locks"],
        "summary": "Create a lock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resources"],
                "properties": {
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/components/schemas/LockResource" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Lock" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/locks/{id}": {
      "put": {
        "tags": ["locks"],
        "summary": "Renew a lock",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Renewed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "ttl", "expiresAt"],
                  "properties": {
                    "id": { "type": "string" },
                    "ttl": { "$ref": "#/components/schemas/TimeUs" },
                    "expiresAt": { "$ref": "#/components/schemas/TimeUs" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["locks"],
        "summary": "Delete a lock (idempotent)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted or already gone" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PinPath": {
        "name": "pin",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 0, "maximum": 7 }
      },
      "XLockId": {
        "name": "X-Lock-Id",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "Required when another lock holds the pin+method. Missing or unknown yields 412; a different live holder yields 423."
      }
    },
    "schemas": {
      "TimeUs": {
        "type": "integer",
        "format": "int64",
        "description": "Unix epoch or duration in microseconds"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "disable",
          "input",
          "output",
          "output_open_drain",
          "input_output",
          "input_output_open_drain"
        ]
      },
      "Edge": {
        "type": "string",
        "enum": ["raising", "falling", "both"]
      },
      "Pins": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "integer", "minimum": 0, "maximum": 7 }
      },
      "GpioConfig": {
        "type": "object",
        "required": ["mode", "pullUp", "pullDown"],
        "properties": {
          "mode": { "$ref": "#/components/schemas/Mode" },
          "pullUp": { "type": "boolean" },
          "pullDown": { "type": "boolean" }
        }
      },
      "GpioState": {
        "type": "object",
        "required": ["pin", "mode", "pullUp", "pullDown", "level"],
        "properties": {
          "pin": { "type": "integer", "minimum": 0, "maximum": 7 },
          "mode": { "$ref": "#/components/schemas/Mode" },
          "pullUp": { "type": "boolean" },
          "pullDown": { "type": "boolean" },
          "level": { "type": "integer", "enum": [0, 1] }
        }
      },
      "PulseBody": {
        "type": "object",
        "required": ["width", "level"],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Microseconds"
          },
          "level": { "type": "integer", "enum": [0, 1] }
        }
      },
      "TraceEvent": {
        "type": "object",
        "required": ["edge", "level", "time"],
        "properties": {
          "edge": { "type": "string", "enum": ["raising", "falling"] },
          "level": { "type": "integer", "enum": [0, 1] },
          "time": { "$ref": "#/components/schemas/TimeUs" }
        }
      },
      "TraceEventWithPin": {
        "allOf": [
          { "$ref": "#/components/schemas/TraceEvent" },
          {
            "type": "object",
            "required": ["pin"],
            "properties": {
              "pin": { "type": "integer", "minimum": 0, "maximum": 7 }
            }
          }
        ]
      },
      "LockResource": {
        "type": "object",
        "required": ["pin", "method"],
        "properties": {
          "pin": { "type": "integer", "minimum": 0, "maximum": 7 },
          "method": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["read", "write"] }
          }
        }
      },
      "Lock": {
        "type": "object",
        "required": ["id", "ttl", "expiresAt", "resources"],
        "properties": {
          "id": { "type": "string" },
          "ttl": { "$ref": "#/components/schemas/TimeUs" },
          "expiresAt": { "$ref": "#/components/schemas/TimeUs" },
          "resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LockResource" }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "description": "Human-readable fix sentence, except invalid_json and internal"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "invalid_json or out-of-range body/query params",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Unknown URL, pin in path out of 0-7, or lock id missing on PUT",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Conflict": {
        "description": "POST /locks overlaps an existing lock",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "PreconditionFailed": {
        "description": "X-Lock-Id missing or unknown/expired",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type must be application/json",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unprocessable": {
        "description": "Pin mode cannot perform the operation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Locked": {
        "description": "Pin+method held by a different live lock",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
