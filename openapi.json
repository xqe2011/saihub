{
  "openapi": "3.1.0",
  "info": {
    "title": "Saihub Pin REST API",
    "version": "1.0.0",
    "description": "No-TLS JSON REST API for logical pins 0-7, PWM, power rails (3v3/5v), edge tracing, resource locks, and on-device Lua scripts. All time fields are microseconds. JSON keys are camelCase. Error bodies are {\"reason\":\"...\"}."
  },
  "servers": [
    {
      "url": "http://{host}",
      "variables": {
        "host": {
          "default": "192.168.1.100"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "pin"
    },
    {
      "name": "power"
    },
    {
      "name": "lock"
    },
    {
      "name": "script"
    },
    {
      "name": "meta"
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": [
          "meta"
        ],
        "summary": "MCP Streamable HTTP endpoint (JSON-RPC 2.0)",
        "description": "Stateless MCP Streamable HTTP transport. POST a single JSON-RPC request or notification. Responses are application/json (no SSE). Notifications and client responses return 202. Pin tools are plural and take pins arrays; create_lock resources use type pin+pins or type power+rails. See tools/list.",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must include application/json and/or text/event-stream"
          },
          {
            "name": "MCP-Protocol-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "2025-06-18",
                "2025-03-26",
                "2024-11-05"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ]
                  },
                  "id": {
                    "description": "Present for requests; omit for notifications",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "description": "initialize, notifications/initialized, ping, tools/list, tools/call"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted notification or client response (empty body)"
          },
          "400": {
            "description": "Invalid JSON-RPC or unsupported MCP-Protocol-Version"
          },
          "406": {
            "description": "Accept header missing required types"
          },
          "415": {
            "description": "Content-Type must be application/json"
          }
        }
      },
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "MCP SSE listen (not supported)",
        "description": "This server does not offer an SSE stream. Returns 405.",
        "responses": {
          "405": {
            "description": "Method Not Allowed"
          }
        }
      },
      "delete": {
        "tags": [
          "meta"
        ],
        "summary": "MCP session terminate (not supported)",
        "description": "Stateless server; sessions are not used. Returns 405.",
        "responses": {
          "405": {
            "description": "Method Not Allowed"
          }
        }
      },
      "options": {
        "tags": [
          "meta"
        ],
        "summary": "CORS preflight for /mcp",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/pin/": {
      "get": {
        "tags": [
          "pin"
        ],
        "summary": "List all logical pins 0-7",
        "parameters": [
          {
            "$ref": "#/components/parameters/XLockId"
