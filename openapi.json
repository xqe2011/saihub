        "responses": {
          "200": {
            "description": "Pin inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pins",
                    "time"
                  ],
                  "properties": {
                    "pins": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PinState"
                      }
                    },
                    "time": {
                      "$ref": "#/components/schemas/TimeUs"
                    }
                  }
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/PreconditionFailed"
          },
          "423": {
            "$ref": "#/components/responses/Locked"
          }
        }
      }
    },
