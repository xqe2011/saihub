    {
      "name": "list_pins",
      "description": "List logical pins 0-7 with mode, pulls, and level.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
