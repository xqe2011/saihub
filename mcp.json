        ],
        "additionalProperties": false,
        "properties": {
          "resources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "pins",
                    "method"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "pin"
                    },
                    "pins": {
                      "$ref": "#/$defs/pins"
                    },
                    "method": {
                      "$ref": "#/$defs/lockMethod"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "rails",
                    "method"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "power"
                    },
                    "rails": {
                      "$ref": "#/$defs/rails"
                    },
                    "method": {
                      "$ref": "#/$defs/lockMethod"
                    }
                  }
                },
