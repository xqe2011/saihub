                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "uart"
                    },
                    "ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "$ref": "#/$defs/uartId"
