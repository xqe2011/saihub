          "pin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "mode": {
            "type": "string",
            "enum": [
              "disable",
              "digitalInput",
              "digitalOutput",
              "digitalInputOutput",
              "pwmOutput"
            ]
          },
          "lockId": {
            "type": "string",
            "minLength": 1,
            "description": "Required when another lock holds the resource."
          }
        }
      }
    },
