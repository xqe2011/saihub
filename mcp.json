    {
      "name": "configure_pins",
      "description": "Configure one or more pins. Always pass pins (e.g. pins:[1]).",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "pins",
          "mode",
          "pullUp",
          "pullDown"
        ],
        "additionalProperties": false,
        "properties": {
          "pins": {
            "$ref": "#/$defs/pins"
          },
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "pullUp": {
            "type": "boolean"
          },
          "pullDown": {
            "type": "boolean"
          },
          "openDrain": {
            "type": "boolean",
            "default": false,
            "description": "Allowed for digitalOutput, digitalInputOutput, and pwmOutput"
          },
          "lockId": {
            "$ref": "#/$defs/lockId"
          }
        },
        "$defs": {
          "pins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/pin"
